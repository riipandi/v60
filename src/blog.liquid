---
layout: base-layout
permalink: /blog/
eleventyNavigation:
  key: Blog
  order: 3
---

<header class="mt-8 sm:mt-10 h-[20rem] bg-gray-100 dark:bg-gray-800 rounded-lg p-4 sm:p-8">
    <div class="container mx-auto px-4 flex h-full py-6 items-center">
        <div class="max-w-2xl">
            <p class="text-blue-500 uppercase tracking-wider text-base">Blog Posts</p>
            <h2 class="text-3xl xl:text-4xl font-bold mt-4 text-gray-800 dark:text-white capitalize">
                Stay hungry, stay foolish.
            </h2>
            <p class="text-gray-500 dark:text-gray-400 mt-4 text-base leading-7">
                We write about building startups and thoughts going on our mind.
            </p>
        </div>
    </div>
</header>

<section class="container mx-auto px-4 mt-16">
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {%- for post in collections.blog reversed -%}
        <article class="flex flex-col">
            <h3 class="text-xl font-bold">
                <a href="{{ post.url }}" class="hover:text-blue-500">{{ post.data.title }}</a>
            </h3>
            {%- if post.data.description -%}
            <p class="mt-2 text-gray-600 dark:text-gray-400">{{ post.data.description }}</p>
            {%- endif -%}
            <time class="mt-4 text-sm text-gray-500" datetime="{{ post.date | date: '%Y-%m-%d' }}">
                {{ post.date | date: "%B %d, %Y" }}
            </time>
        </article>
        {%- endfor -%}
    </div>
</section>

{% comment %} <section class="mt-16">
    {% set postslist = collections.blog %}
    {% include "postslist.njk" %}
</section> {% endcomment %}
