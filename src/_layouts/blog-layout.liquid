---
layout: base-layout
---

<article class="container mx-auto px-4 py-16">
    <header class="max-w-3xl mx-auto mb-12">
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl mb-4">
            {{ title }}
        </h1>

        {% if description %}
        <p class="text-xl text-gray-600 dark:text-gray-400">
            {{ description }}
        </p>
        {% endif %}

        <div class="mt-6 flex items-center gap-x-4 text-sm text-gray-600 dark:text-gray-400">
            <time datetime="{{ date | date: '%Y-%m-%d' }}">
                {{ date | date: "%B %d, %Y" }}
            </time>
            {% if tags %}
            <div class="flex items-center gap-x-2">
                •
                {% for tag in tags %}
                    {% if tag != "post" %}
                    <span class="inline-flex items-center rounded-md bg-gray-100 dark:bg-gray-800 px-2 py-1 text-sm">
                        {{ tag }}
                    </span>
                    {% endif %}
                {% endfor %}
            </div>
            {% endif %}
        </div>
    </header>

    <div class="prose prose-lg dark:prose-invert mx-auto">
        {{ content }}
    </div>

    {% if collections.post.length > 1 %}
    <div class="max-w-3xl mx-auto mt-16 pt-8 border-t dark:border-gray-800">
        <h2 class="text-2xl font-bold mb-8">Other Posts</h2>
        <div class="grid gap-8 sm:grid-cols-2">
            {% assign posts = collections.post | reverse %}
            {% for post in posts limit: 2 %}
                {% if post.url != page.url %}
                <a href="{{ post.url }}" class="block group">
                    <h3 class="font-semibold group-hover:text-blue-600">{{ post.data.title }}</h3>
                    {% if post.data.description %}
                    <p class="mt-2 text-gray-600 dark:text-gray-400">{{ post.data.description }}</p>
                    {% endif %}
                </a>
                {% endif %}
            {% endfor %}
        </div>
    </div>
    {% endif %}
</article>
