---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
    <title>{{ meta.title }}</title>
    <subtitle>{{ meta.description }}</subtitle>
    <link href="{{ meta.url }}/feed.xml" rel="self" type="application/atom+xml" />
    <link href="{{ meta.url }}" rel="alternate" type="text/html"/>
    <author>
        <name>{{ meta.title }}</name>
    </author>
    {% if collections.blog %}
        <updated>{{ collections.blog | first | date: '%Y-%m-%dT%H:%M:%SZ' }}</updated>
    {% endif %}
    <id>{{ meta.url }}/</id>
    {%- for post in collections.blog reversed -%}
        <entry>
            <title>{{ post.data.title }}</title>
            <link href="{{ meta.url }}{{ post.url }}"/>
            <updated>{{ post.date | date: '%Y-%m-%dT%H:%M:%SZ' }}</updated>
            <id>{{ meta.url }}{{ post.url }}</id>
            <content type="html">
                <![CDATA[{{ post.templateContent }}]]>
            </content>
        </entry>
    {%- endfor -%}
</feed>
